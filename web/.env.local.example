# Supabase Configuration
# Copy this file to .env.local and fill in your values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Privacy safeguard: nominal candidate data stays disabled unless this
# server-only flag is deliberately enabled after legal/privacy review.
ENABLE_NOMINAL_APPROVED_STUDENTS=false

# Set only while an edition is actively receiving partial captures. When left
# blank, only a same-year capture from the last 36 hours is inferred as active.
SISU_ACTIVE_EDITION=

# IMPORTANT: Never commit .env.local to git!
# The service key has full database access - keep it secret
